@startuml
title UC5 - Editar Médico

|Administrador|
start
|Sistema|
:Listar médicos (nome, CRM/UF, especialidade\ne situação), incluindo os Inativos;
|Administrador|
:Selecionar médico;
|Sistema|
:Exibir dados atuais, especialidade,\ngrade e situação;
repeat
  repeat
    repeat
      |Administrador|
      :Alterar dados desejados e\nescolher salvar ou desistir;
      |Sistema|
      if (Opção escolhida?) then ([salvar])
      else ([desistir])
        :Descartar alterações;
        stop
      endif
      :Validar campos obrigatórios\ne coerência da grade;
      backward:Sinalizar campos\n(mantendo os dados);
    repeat while (Dados válidos e grade coerente?) is ([não]) not ([sim])
    :Verificar unicidade de CRM + UF (RN02);
    backward:Informar "CRM já cadastrado no sistema";
  repeat while (CRM + UF único?) is ([não]) not ([sim])
  :Verificar consultas futuras Agendadas\n(se alterou a grade ou inativou - RN08);
  backward:Informar que é preciso cancelar\nas consultas futuras antes (UC9);
repeat while (Alteração permitida (RN08)?) is ([não]) not ([sim])
:Solicitar confirmação;
|Administrador|
:Confirmar ou desistir;
|Sistema|
if (Alteração confirmada?) then ([sim])
else ([não])
  :Descartar alterações;
  stop
endif
:Gravar alterações e confirmar atualização;
stop
@enduml
