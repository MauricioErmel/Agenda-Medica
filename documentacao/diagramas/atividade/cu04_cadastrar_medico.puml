@startuml
title CU4 - Cadastrar Médico

|Administrador|
start
|Sistema|
:Solicitar nome completo, CRM, UF, especialidade\ne grade (um turno por dia de atendimento);
repeat
  repeat
    |Administrador|
    :Informar dados do médico e\nescolher salvar ou desistir;
    |Sistema|
    if (Opção escolhida?) then ([salvar])
    else ([desistir])
      :Descartar dados;
      stop
    endif
    :Validar campos obrigatórios (ao menos um dia\nna grade) e coerência da grade (fim > início);
    backward:Sinalizar campos\n(mantendo os dados);
  repeat while (Dados válidos e grade coerente?) is ([não]) not ([sim])
  :Verificar unicidade de CRM + UF (RN02);
  backward:Informar "CRM já cadastrado no sistema"\n(mantendo os dados);
repeat while (CRM + UF único?) is ([não]) not ([sim])
:Gravar médico como Ativo\ne confirmar cadastro;
stop
@enduml
