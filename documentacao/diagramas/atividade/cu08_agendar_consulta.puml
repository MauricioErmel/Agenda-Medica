@startuml
title CU8 - Agendar Consulta

|Recepcionista|
start
repeat
  repeat
    |Recepcionista|
    :Informar CPF ou parte do nome\nou desistir;
    |Sistema|
    if (Opção escolhida?) then ([buscar])
    else ([desistir])
      stop
    endif
    :Buscar pacientes;
    backward:Informar "Paciente não localizado";
  repeat while (Paciente encontrado?) is ([não]) not ([sim])
  :Listar pacientes encontrados\n(nome, data de nascimento, CPF e situação);
  |Recepcionista|
  :Selecionar paciente;
  |Sistema|
  :Verificar situação do paciente;
  backward:Informar que pacientes inativos\nnão podem ser agendados;
repeat while (Paciente Ativo?) is ([não]) not ([sim])
repeat
  |Recepcionista|
  :Selecionar médico Ativo e data\nou desistir;
  |Sistema|
  if (Opção escolhida?) then ([prosseguir])
  else ([desistir])
    stop
  endif
  :Listar horários livres do médico\nna data selecionada (RN07);
  backward:Informar "Nenhum horário disponível";
repeat while (Há horários livres?) is ([não]) not ([sim])
repeat
  |Recepcionista|
  :Selecionar horário e confirmar\nou desistir;
  |Sistema|
  if (Opção escolhida?) then ([confirmar])
  else ([desistir])
    stop
  endif
  :Verificar se o paciente já tem consulta\nAgendada no mesmo horário (RN05);
  backward:Informar o conflito e listar\nnovamente os horários livres;
repeat while (Horário livre para o paciente?) is ([não]) not ([sim])
:Gravar consulta como Agendada\ncom lembrete Pendente;
:Confirmar agendamento informando\ndata, hora, médico e especialidade;
stop
@enduml
