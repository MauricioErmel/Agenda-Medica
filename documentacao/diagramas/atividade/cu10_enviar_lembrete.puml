@startuml
title CU10 - Enviar Lembrete de Consulta

|Recepcionista|
start
repeat
  |Sistema|
  :Listar consultas futuras Agendadas com lembrete\nPendente, em ordem cronológica (RN09);
  if (Há lembretes pendentes?) then ([sim])
  else ([não])
    :Informar "Nenhuma consulta\ncom lembrete pendente";
    stop
  endif
  |Recepcionista|
  :Selecionar consulta;
  |Sistema|
  :Montar mensagem padrão e abrir WhatsApp\ncom telefone do paciente e mensagem;
  |Recepcionista|
  :Enviar mensagem no WhatsApp\ne voltar ao sistema;
  :Confirmar ou não o envio;
  |Sistema|
  backward:Manter lembrete como Pendente;
repeat while (Envio confirmado?) is ([não]) not ([sim])
:Marcar lembrete como Enviado\ne retirar consulta da lista;
stop
@enduml
