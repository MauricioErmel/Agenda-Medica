@startuml
left to right direction
skinparam packageStyle rectangle

actor "Administrador" as Admin
actor "Recepcionista" as Recep

rectangle "Sistema de Agenda Médica" {
  usecase "UC1: Entrar no Sistema" as UC1
  usecase "UC2: Cadastrar Recepcionista" as UC2
  usecase "UC3: Editar Recepcionista" as UC3
  usecase "UC4: Cadastrar Médico" as UC4
  usecase "UC5: Editar Médico" as UC5
  usecase "UC6: Cadastrar Paciente" as UC6
  usecase "UC7: Consultar e Editar Paciente" as UC7
  usecase "UC8: Agendar Consulta" as UC8
  usecase "UC9: Cancelar Consulta" as UC9
  usecase "UC10: Enviar Lembrete de Consulta" as UC10
  usecase "UC11: Registrar Ausência do Médico" as UC11
}

Admin -- UC1
Admin -- UC2
Admin -- UC3
Admin -- UC4
Admin -- UC5

UC1 -- Recep
UC6 -- Recep
UC7 -- Recep
UC8 -- Recep
UC9 -- Recep
UC10 -- Recep
UC11 -- Recep

@enduml
