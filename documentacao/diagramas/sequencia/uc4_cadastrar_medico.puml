@startuml
title Diagrama de Sequência - UC4: Cadastrar Médico
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Administrador" as Admin
participant ":MedicoView" as View
participant ":MedicoController" as Ctrl
participant "Especialidade" as EspClass <<class>>
participant "Medico" as MedClass <<class>>
participant "grade : GradeAtendimento" as Grade

Admin -> View : acionarCadastroMedico()
activate View

View -> Ctrl : listarEspecialidades()
activate Ctrl
Ctrl -> EspClass : listarTodas()
activate EspClass
EspClass -->> Ctrl : especialidades : List<Especialidade>
deactivate EspClass
Ctrl -->> View : especialidades
deactivate Ctrl

View -> View : exibirFormulario(null, especialidades)
activate View
deactivate View
View -->> Admin : solicita nome, CRM, UF, especialidade e grade
deactivate View

alt Administrador informa dados e solicita salvar
  Admin -> View : enviarCadastro(nome, crm, ufCrm, especialidadeId, grades)
  activate View

  View -> Ctrl : cadastrarMedico(nome, crm, ufCrm, especialidadeId, grades)
  activate Ctrl

  loop para cada grade em grades
    Ctrl -> Grade : isHorarioValido()
    activate Grade
    Grade -->> Ctrl : valido : boolean
    deactivate Grade
  end

  alt campos obrigatórios vazios, grade vazia ou algum horário inválido
    Ctrl -->> View : "Dados inválidos ou grade incoerente"
  else dados e grade válidos
    Ctrl -> MedClass : existeCrmUf(crm, ufCrm, 0)
    activate MedClass
    MedClass -->> Ctrl : existe : boolean
    deactivate MedClass

    alt existe == true (RN02)
      Ctrl -->> View : "CRM já cadastrado no sistema"
    else existe == false
      Ctrl -> EspClass : buscarPorId(especialidadeId)
      activate EspClass
      EspClass -->> Ctrl : especialidade : Especialidade
      deactivate EspClass

      create "novoMedico : Medico" as NovoMed
      Ctrl -->> NovoMed : <<create>>

      Ctrl -> NovoMed : setNome(nome)
      activate NovoMed
      deactivate NovoMed

      Ctrl -> NovoMed : setCrm(crm)
      activate NovoMed
      deactivate NovoMed

      Ctrl -> NovoMed : setUfCrm(ufCrm)
      activate NovoMed
      deactivate NovoMed

      Ctrl -> NovoMed : setEspecialidade(especialidade)
      activate NovoMed
      deactivate NovoMed

      Ctrl -> NovoMed : setSituacao(Situacao.ATIVO)
      activate NovoMed
      deactivate NovoMed

      Ctrl -> NovoMed : setGrades(grades)
      activate NovoMed
      deactivate NovoMed

      Ctrl -> NovoMed : salvar()
      activate NovoMed
      NovoMed -->> Ctrl : true
      deactivate NovoMed

      Ctrl -->> View : "Médico cadastrado com sucesso!"
    end
  end
  deactivate Ctrl

  View -> View : exibirMensagem(mensagem, tipo)
  activate View
  deactivate View
  View -->> Admin : exibe confirmação ou sinaliza erro mantendo dados
  deactivate View

else Administrador desiste antes de salvar
  Admin -> View : cancelar()
  activate View
  View -->> Admin : descarta dados e encerra
  deactivate View
end
@enduml
