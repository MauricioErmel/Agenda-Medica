@startuml
title Diagrama de Sequência - CU1: Entrar no Sistema
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Usuário\n(Recepcionista / Administrador)" as User
participant ":LoginView" as View
participant ":AuthController" as Ctrl
participant "Usuario" as UsuarioClass <<class>>
participant "usuario : Usuario" as UsuarioObj

User -> View : abrirSistema()
activate View
View -> View : exibirFormulario()
activate View
deactivate View
View -->> User : exibe formulário de login e senha
deactivate View

User -> View : enviarCredenciais(login, senha)
activate View

View -> Ctrl : entrar(login, senha)
activate Ctrl

Ctrl -> UsuarioClass : autenticar(login, senha)
activate UsuarioClass
UsuarioClass -->> Ctrl : usuario : Usuario
deactivate UsuarioClass

Ctrl -->> View : usuario
deactivate Ctrl

alt usuario != null
  View -> UsuarioObj : getPerfil()
  activate UsuarioObj
  UsuarioObj -->> View : perfil : Perfil
  deactivate UsuarioObj

  View -> View : exibirMenu(perfil)
  activate View
  deactivate View
  View -->> User : libera funções do perfil
else usuario == null
  View -> View : exibirErro("Login ou senha inválidos")
  activate View
  deactivate View
  View -> View : exibirFormulario()
  activate View
  deactivate View
  View -->> User : informa erro e retorna ao formulário
end

deactivate View
@enduml
